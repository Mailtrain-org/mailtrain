{
  "name": "mailtrain-client",
  "version": "3.0.0",
  "description": "Self hosted email newsletter app - client components",
  "main": "index.js",
  "scripts": {
    "js": "webpack",
    "watch-js": "webpack --watch",
    "css": "npm-run-all --sequential css-compile css-minify",
    "css-compile": "node-sass --output-style expanded --source-map true --source-map-contents true --precision 6 --include-path node_modules src/scss/mailtrain.scss dist/mailtrain.css",
    "css-minify": "cd dist && cleancss --source-map --source-map-inline-sources --output mailtrain.min.css mailtrain.css",
    "watch-css": "nodemon --watch src/scss -e scss -x \"npm run css\"",
    "watch": "npm-run-all --parallel watch-css watch-js",
    "build": "npm-run-all --parallel css js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Mailtrain-org/mailtrain.git"
  },
  "license": "GPL-3.0",
  "homepage": "https://mailtrain.org/",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "axios": "^1.7.4",
    "bootstrap": "^5.3.3",
    "clone": "^2.1.2",
    "datatables.net": "^2.1.4",
    "datatables.net-bs5": "^2.1.4",
    "ellipsize": "^0.5.1",
    "htmlparser2": "^9.1.0",
    "i18next": "^23.13.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "immutable": "^4.3.7",
    "juice": "^10.0.1",
    "lodash": "^4.17.21",
    "mjml-browser": "file:mjml/packages/mjml-browser",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "prop-types": "^15.8.1",
    "querystringify": "^2.2.0",
    "react": "^18.3.1",
    "react-ace": "^12.0.0",
    "react-color": "^2.19.3",
    "react-day-picker": "^9.0.8",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-google-charts": "^4.0.1",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^5.3.4",
    "@nosferatu500/react-sortable-tree": "^4.4.0",
    "shallowequal": "^1.1.0",
    "slugify": "^1.6.6",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/plugin-proposal-decorators": "^7.24.7",
    "@babel/plugin-proposal-function-bind": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "clean-css-cli": "^5.6.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "node-sass": "^9.0.0",
    "nodemon": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  }
}
