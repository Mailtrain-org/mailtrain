{
  "name": "mailtrain-client",
  "version": "3.0.0",
  "description": "Self hosted email newsletter app - client components",
  "main": "index.js",
  "scripts": {
    "js": "webpack",
    "watch-js": "webpack --watch",
    "css": "npm-run-all --sequential css-compile css-minify",
    "css-compile": "sass --source-map --load-path=node_modules src/scss/mailtrain.scss dist/mailtrain.css",
    "css-minify": "cd dist && cleancss --source-map --source-map-inline-sources --output mailtrain.min.css mailtrain.css",
    "watch-css": "nodemon --watch src/scss -e scss -x \"npm run css\"",
    "watch": "npm-run-all --parallel watch-css watch-js",
    "build": "npm-run-all --parallel css js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Mailtrain-org/mailtrain.git"
  },
  "license": "GPL-3.0",
  "homepage": "https://mailtrain.org/",
  "dependencies": {
    "@nosferatu500/react-sortable-tree": "^4.4.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.12.2",
    "bootstrap": "^5.3.8",
    "clone": "^2.1.2",
    "datatables.net": "^2.3.4",
    "datatables.net-bs5": "^2.3.4",
    "ellipsize": "^0.7.0",
    "htmlparser2": "^10.0.0",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "immutable": "^5.1.3",
    "juice": "^11.0.3",
    "lodash": "^4.17.21",
    "mjml-browser": "file:mjml/packages/mjml-browser",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "prop-types": "^15.8.1",
    "querystringify": "^2.2.0",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-color": "^2.19.3",
    "react-day-picker": "^9.11.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-google-charts": "^5.2.1",
    "react-i18next": "^16.0.0",
    "slugify": "^1.6.6",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-proposal-function-bind": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^10.0.0",
    "clean-css-cli": "^5.6.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "sass": "1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  }
}
